[Unit]
Description=Sentinela Verde Web App
After=network.target

[Service]
Type=simple
User=sentinela
WorkingDirectory=/opt/sentinela_verde
EnvironmentFile=/opt/sentinela_verde/.env
ExecStart=/opt/sentinela_verde/venv/bin/uvicorn sentinela_verde.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
